/* ----------------------------
GLOBAL BACKGROUND
---------------------------- */
QWidget {
    background-color: #FFF9F7; /*light creamy  THIS IS FOR THE LEGIT BACKGROUND */
}

/* ----------------------------
BUTTONS
---------------------------- */
QPushButton {
    background-color: white;   /* very light pink fill */
    border: 3px solid #7A4B5A;   /* dark pink border */
    border-radius: 18px;
    padding: 20px;
    font-weight: bold;
    font-family: Cascadia Code;
    color: #7A4B5A;
}

QPushButton:hover {
    background-color: #FFE3EA;   /* slightly darker on hover */
}

QPushButton:pressed {
    background-color: #F7B7C3;   /* stronger pink when clicked */
}

/* ----------------------------
TITLE LABEL
---------------------------- */
QLabel#title {
    font-size: 30px;
    font-weight: bold;
    color: #7A4B5A;
    font-family: Cascadia Code;
    padding: 20px;
}

/* ----------------------------
CARD LABELS (GPS boxes)
---------------------------- */
QLabel.card {
    font-size: 22px;
    color: #7A4B5A;
    font-weight: bold;

    background-color: white;

    border: 4px solid #7A4B5A;
    border-radius: 14px;

    padding: 10px;
    min-width: 170px;
    min-height: 55px;

    font-family: Cascadia Code;
}

/* ----------------------------
STATUS LABEL
---------------------------- */
QLabel#status {
    font-size: 22px;
    color: #7A4B5A;
    font-weight: bold;

    background-color: white;

    border: 4px solid #7A4B5A;
    border-radius: 14px;

    padding: 10px;
    min-height: 55px;

    font-family: Cascadia Code;
}

/* ----------------------------
PANELS
---------------------------- */
QFrame {
    background-color: #FCC1C9;
    border-radius: 25px;
    padding: 20px;
    border: 4px solid #7A4B5A;
}